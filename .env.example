# ============================================================
# Verdict — environment configuration
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored. This template is committed, so never
# put a real key in it.
#
# The app runs with NONE of these set: sessions use a development
# secret written to data/.dev-auth-secret, and the database is
# created at data/app.db on first request. Only payments and the
# admin panel need configuration before they do anything.
#
# Payment credentials here are a SEED AND A FALLBACK. The live
# source of truth is the `payment_gateways` table, edited at
# /admin/payment-gateways, where secrets are encrypted at rest.
# ============================================================


# ── required in production ──────────────────────────────────
# Signs session cookies. Must be at least 32 characters.
# Rotating it logs everyone out. Generate one with:
#   openssl rand -base64 48
# In development this may be omitted; a random secret is
# generated and stored in data/.dev-auth-secret. In production a
# missing or short value is a hard startup error.
AUTH_SECRET=

# Encrypts payment gateway secrets stored in the database
# (AES-256-GCM). At least 32 characters. If it is absent, a key is
# derived from AUTH_SECRET under a separate HKDF label, so a fresh
# deployment works without it — but then rotating AUTH_SECRET also
# invalidates every stored gateway secret. Set both in production.
#   openssl rand -base64 48
CREDENTIALS_SECRET=

# Public origin of the app, no trailing slash. Used to build
# gateway callback URLs, the host shown on invoices and every link
# inside emails. In production set it to your real https:// URL
# (e.g. https://yourdomain.com). APP_URL is accepted as another name.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── first admin ─────────────────────────────────────────────
# Bootstraps the admin panel on database open. BOTH must be set
# for anything to happen. The password is hashed with the same
# scrypt parameters as any other account and is never stored in
# plain text.
#
# If the account already exists, only its role is raised — a
# redeploy will not reset a password the admin has changed. Sign
# in at /login as normal; the panel is at /admin.
#
# Remove these from the environment once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator


# ── email: sign-up verification codes ───────────────────────
# New accounts confirm their address with a 6-digit code sent by
# email before the account exists. Without a working provider,
# production REFUSES new sign-ups (existing accounts can still log
# in) rather than pretending a code was sent. Payment alerts use
# the same provider.
#
# Google SMTP (recommended). Setting SMTP_USER selects it; you can
# also say EMAIL_PROVIDER=smtp. Setup steps: README → "Email
# (Google SMTP)".
#   SMTP_HOST          smtp.gmail.com (the default)
#   SMTP_PORT          587 with SMTP_SECURE=false (STARTTLS, required)
#                      or 465 with SMTP_SECURE=true (TLS from the start)
#   SMTP_USER          the full Gmail / Google Workspace address
#   SMTP_APP_PASSWORD  a Google App Password for that account — NEVER
#                      its normal password. Spaces are ignored.
#   EMAIL_FROM         defaults to SMTP_USER. Must be that address or a
#                      "Send mail as" alias verified in Gmail, e.g.
#                      AdSense Checker <you@gmail.com>
# These are server-side only: never prefix them with NEXT_PUBLIC_
# and never commit real values.
EMAIL_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
# Optional: where replies go.
EMAIL_REPLY_TO=
#
# Resend (https://resend.com) still works instead: EMAIL_PROVIDER=resend,
# RESEND_API_KEY, and an EMAIL_FROM on your verified domain.
RESEND_API_KEY=
# Test-only: send to a different Resend-compatible URL. The test
# suite points this at a local stand-in. Leave unset in production.
RESEND_API_URL=
#
# EMAIL_PROVIDER=console is for local development only: it prints
# each email (including the code) to the server terminal instead
# of sending it, and is refused when NODE_ENV=production. It is
# the default in development when nothing here is set.


# ── payment & checkout alerts ───────────────────────────────
# Alerts are emailed through the provider above to the address set in
# Admin → Notifications (not configured here).
#
# ── scheduled jobs (README → Scheduled jobs) ────────────────
# CRON_SECRET protects the three scheduled-job endpoints, which a
# scheduler (e.g. a Render Cron Job running
# `node scripts/run-scheduled-jobs.mjs`) should call every 5–10 minutes:
#   POST /api/internal/jobs/checkout-alerts  abandoned checkouts, alert retries
#   POST /api/internal/jobs/ml               prediction feedback emails, training
#   POST /api/internal/jobs/rescans          Pro weekly rescans
# At least 32 random characters, e.g.
#   openssl rand -hex 32
# Without it every one of those endpoints refuses every request. Set the
# same value on the scheduler, together with APP_URL (the site address).
CRON_SECRET=
# The server also runs each job every 5 minutes on its own while it is
# awake, as a safety net. Set to "off" to disable that, per job.
CHECKOUT_ALERTS_BACKGROUND=
ML_BACKGROUND=
RESCANS_BACKGROUND=
# Hour (UTC) of the nightly model training. Default 21 (02:30 IST).
ML_TRAIN_HOUR_UTC=


# ── payments: Razorpay (INR) ────────────────────────────────
# Razorpay Dashboard → Settings → API Keys. rzp_test_* keys hit
# the real API in test mode, which is what you want for
# end-to-end testing.
#
# KEY_ID reaches the browser to open Razorpay Checkout; that is by
# design and is safe. KEY_SECRET and WEBHOOK_SECRET are read
# server-side only and must never be prefixed with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Settings → Webhooks. Point the endpoint at
# {NEXT_PUBLIC_APP_URL}/api/webhooks/razorpay and subscribe to
# payment.captured, order.paid and payment.failed. Without this
# secret the route rejects every delivery: an unverified webhook is
# worse than no webhook.
RAZORPAY_WEBHOOK_SECRET=


# ── payments: Cashfree (INR) ────────────────────────────────
# Cashfree Dashboard → Developers → API Keys. Webhook endpoint:
# {NEXT_PUBLIC_APP_URL}/api/webhooks/cashfree — subscribe to
# PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK and
# PAYMENT_USER_DROPPED_WEBHOOK. Signatures are verified as base64
# HMAC-SHA256 over timestamp + raw body.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# sandbox (default) or live. Selects the API host.
CASHFREE_ENVIRONMENT=sandbox


# ── payments: PayPal (USD) ──────────────────────────────────
# PayPal Developer → Apps & Credentials. Webhook endpoint:
# {NEXT_PUBLIC_APP_URL}/api/webhooks/paypal — subscribe to
# PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
# PAYMENT.CAPTURE.REVERSED and CHECKOUT.ORDER.VOIDED. The webhook
# id is required: deliveries are verified by calling PayPal's
# verify-webhook-signature API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# sandbox (default) or live. Selects the API host.
PAYPAL_ENVIRONMENT=sandbox

# Note: PayPal will not settle INR for most merchant accounts, so
# it also needs a settlement currency (e.g. USD) and the ₹-per-unit
# rate you maintain. Those two fields exist only in the admin panel
# at /admin/payment-gateways — the app will not invent an exchange
# rate, and PayPal stays unconfigurable until they are set.


# ── payments: local simulator ───────────────────────────────
# Simulates the full checkout → verify → subscription flow with no
# gateway account at all. Refused entirely when
# NODE_ENV=production. Every row it writes is stamped mode='mock'
# and is labelled "Test payment" on the billing page and the
# invoice, so a simulated purchase can never be mistaken for a
# real one.
#   PAYMENTS_MODE=mock
PAYMENTS_MODE=


# ── storage ─────────────────────────────────────────────────
# Where the SQLite file and the dev session secret live.
# Defaults to ./data. Point this at a persistent volume when
# deploying; a container filesystem will lose every account and
# report on redeploy.
DATA_DIR=

# Optional. Where profile photos are stored; defaults to <DATA_DIR>/avatars.
# On Render, DATA_DIR must be on a persistent disk (it holds the database),
# and photos are kept there too — so they survive restarts and redeploys.
AVATAR_DIR=


# ── analysis engine (optional tuning) ───────────────────────
# Pages fetched per audit when no plan page limit applies (older
# code paths). Scans use the plan's "pages per scan" (Admin -> Plans).
# Default 6.
ANALYSIS_MAX_PAGES=

# Longest a scan may run, in milliseconds, however many pages its plan
# allows. Default 240000 (4 minutes).
ANALYSIS_MAX_DEADLINE_MS=

# Scans running at once in this server process; more wait their turn.
# Default 3 (1-20).
ANALYSIS_CONCURRENT_JOBS=

# Per-request timeout in milliseconds. Default 12000.
ANALYSIS_TIMEOUT_MS=

# Sent as the User-Agent when fetching a site being audited.
ANALYSIS_USER_AGENT=

# Allows auditing private address space — localhost, 10.x,
# 192.168.x, link-local, cloud metadata, and so on. Off by
# default: refusing private addresses is what stops the analyser
# being used as an SSRF proxy into your network. Ignored in
# production.
#   ALLOW_PRIVATE_ANALYSIS_HOSTS=true
ALLOW_PRIVATE_ANALYSIS_HOSTS=

# For machines with no outbound network. When a site genuinely
# cannot be reached, records a clearly-labelled demo report
# instead of failing, so the checker → report → history flow
# stays testable offline. Such reports are permanently marked
# "Demo data" everywhere they appear. A deliberately refused
# address is still refused — this never turns "we will not scan
# your router" into a cheerful sample. Ignored in production.
#   ANALYSIS_DEMO_FALLBACK=true
ANALYSIS_DEMO_FALLBACK=

# Website analytics: only if a trusted proxy in front of the site sets a
# visitor-country header (e.g. Cloudflare's CF-IPCountry). Leave empty on
# plain Render — countries are then shown as "not measured".
#   ANALYTICS_COUNTRY_HEADER=cf-ipcountry
ANALYTICS_COUNTRY_HEADER=
