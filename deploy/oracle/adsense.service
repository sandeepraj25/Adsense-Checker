[Unit]
Description=AdSense Eligibility Checker (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
# Listens on the loopback only; Caddy is the only way in from outside.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p __PORT__
Restart=always
RestartSec=5
# Give background scans a moment to finish on stop/restart.
TimeoutStopSec=30

# Hardening: the app may write only its own folder and its data.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__APP_DIR__ __DATA_ROOT__

[Install]
WantedBy=multi-user.target
