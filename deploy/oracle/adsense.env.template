# Production settings for the AdSense Checker on an Oracle Cloud VM.
#
# setup.sh copies this to /etc/adsense/adsense.env (readable only by root
# and the app's user) and fills in the four secrets marked AUTO with fresh
# random values. Fill in the rest, then run:  sudo systemctl restart adsense
#
# Never commit the filled-in copy. Every variable is described in
# .env.example in the project.

NODE_ENV=production

# ── site ─────────────────────────────────────────────────────
# Your domain, with https:// and no trailing slash. Links in emails use it.
NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN

# AUTO: signs sessions. If you are MOVING an existing database here from
# another server, put that server's values for AUTH_SECRET and
# CREDENTIALS_SECRET here instead — otherwise everyone is logged out and
# the payment-gateway keys saved in the admin panel can't be decrypted.
AUTH_SECRET=__AUTO__
CREDENTIALS_SECRET=__AUTO__

# Where the database, avatars and caches live (on the VM's own disk).
DATA_DIR=/var/lib/adsense/data

# ── first administrator (used once, on an empty database) ─────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── email (sign-up codes, alerts, feedback) ──────────────────
# Gmail: an App Password (16 letters), port 587. If Gmail can't be reached
# from Oracle, use OCI Email Delivery's SMTP host and credentials instead.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── scheduled jobs ───────────────────────────────────────────
# AUTO: the VM's cron (/etc/cron.d/adsense-jobs) uses the same value.
CRON_SECRET=__AUTO__

# ── payments (or set them in Admin → Payment gateways) ───────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=live
